# ===================================================================
#  설정 파일 예시 — 이 파일은 git에 올라갑니다. 실제 값을 넣지 마세요.
#  실제 값은 옆에 있는 .env 파일에 넣습니다. (.env는 git에 안 올라감)
# ===================================================================

# [필수] Anthropic API 키
# console.anthropic.com → API Keys 에서 발급. sk-ant- 로 시작합니다.
ANTHROPIC_API_KEY=

# [필수] 사용할 AI 모델
# claude-haiku-4-5  : 가장 저렴 ($1/$5 per 1M) — M3 시작값
# claude-sonnet-5   : 중간      ($2/$10 per 1M)
# claude-opus-5     : 가장 정확 ($5/$25 per 1M)
ANTHROPIC_MODEL=claude-haiku-4-5

# [선택] 평가용 기준일 고정 (재현 가능한 결과를 위해)
# 샘플 메일 모드에서만 적용됩니다. 실제 메일에는 언제나 진짜 오늘을 씁니다.
TODAY_OVERRIDE=2026-09-21

# [선택] AI에 보내기 전 개인정보(전화번호·학번 등) 가리기
MASK_PII=true

# ===================================================================
#  아래는 M7(경희대 메일 연동)에서만 필요합니다. 지금은 비워두세요.
# ===================================================================

IMAP_HOST=imap.gmail.com
# 본인 학교 메일 주소 전체 (예: hong@khu.ac.kr)
IMAP_USER=
# Google 계정에서 만든 16자리 앱 비밀번호 (일반 비밀번호 아님, 공백 없이)
IMAP_APP_PASSWORD=
